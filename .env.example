# Copy to .env and fill in. .env is git-ignored.

# NEAR testnet account that owns the deployment (created with near-cli-rs, key in the system keychain)
BAKEOFF_ACCOUNT=

# NEAR AI Cloud API key used by the evaluator for model calls.
# Only needed for live runs; local runs use the mock API.
BAKEOFF_LLM_API_KEY=
